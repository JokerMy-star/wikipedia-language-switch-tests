{
	"compilerOptions": {
		"target": "ES2022",
		"module": "node18",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
