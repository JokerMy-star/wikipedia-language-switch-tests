{
  "name": "wikipedia-language-switch-tests",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E test: an authorised Wikipedia user changes the interface language in Preferences.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit",
    "docker:test": "docker compose run --rm --build tests"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "typescript": "^7.0.2"
  },
  "private": true
}
