# Wikipedia account used by the test. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
WIKI_USERNAME=your-wikipedia-login
WIKI_PASSWORD=your-wikipedia-password

# Wiki under test. Interface preferences are stored per wiki,
# so the whole scenario runs against this one host.
BASE_URL=https://uk.wikipedia.org

# Interface language the account starts from (restored when the test finishes).
INITIAL_LANGUAGE=uk
# Interface language the user switches to during the test.
TARGET_LANGUAGE=en
